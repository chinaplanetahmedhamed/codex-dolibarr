# Module installation/migration SQL is source code, not a database dump.
!custom/
!custom/*/
!custom/*/sql/
!custom/*/sql/*.sql

# M140 private runtime/configuration never belongs in Git
/htdocs/conf/conf.php
**/.env
**/mysql-local.cnf
**/local-access.json
**/boards-statements-*.json*
**/candidate/db/

# Private/generated local evidence is retained outside the code baseline
/outputs/
# Public owner-module installation/migration schemas belong in source
!custom/**/sql/**/*.sql
!custom/**/schema/**/*.sql
